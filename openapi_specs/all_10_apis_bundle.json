  "components": {
    "schemas": {
      "CronScheduleRequest": {
        "properties": {
          "expression_or_text": {
            "type": "string",
            "title": "Expression Or Text",
            "description": "Standard 5-field cron expression (e.g. '*/15 * * * *') or natural phrase (e.g. 'every weekday at 9am').",
            "default": "0 9 * * 1-5"
          },
          "timezone_name": {
            "type": "string",
            "title": "Timezone Name",
            "description": "IANA timezone name (e.g. 'UTC', 'America/New_York', 'Asia/Kolkata').",
            "default": "UTC"
          },
          "next_runs_count": {
            "type": "integer",
            "maximum": 25.0,
            "minimum": 1.0,
            "title": "Next Runs Count",
            "description": "Number of upcoming execution timestamps to calculate.",
            "default": 5
          }
        },
        "type": "object",
        "title": "CronScheduleRequest"
      },
      "CronScheduleResponse": {
        "properties": {
          "cron_expression": {
            "type": "string",
            "title": "Cron Expression"
          },
          "human_summary": {
            "type": "string",
            "title": "Human Summary"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "next_executions_iso": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Next Executions Iso"
          },
          "seconds_until_next_run": {
            "type": "integer",
            "title": "Seconds Until Next Run"
          }
        },
        "type": "object",
        "required": [
          "cron_expression",
          "human_summary",
          "timezone",
          "next_executions_iso",
          "seconds_until_next_run"
        ],
        "title": "CronScheduleResponse"
      },
