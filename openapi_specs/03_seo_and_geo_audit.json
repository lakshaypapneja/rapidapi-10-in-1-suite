{
  "openapi": "3.0.3",
  "info": {
    "title": "Technical SEO & AI Search (GEO) Audit API",
    "description": "Audit any webpage for 0-100 Technical SEO score, meta tags, heading structure, JSON-LD schema, and AI-search readiness.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://rapidapi-10-in-1-suite.onrender.com",
      "description": "Production Render Cloud Server"
    }
  ],
  "paths": {
    "/api/v1/seo-audit/analyze": {
      "post": {
        "tags": [
          "3. Technical SEO & GEO (AI Search) Audit"
        ],
        "summary": "Perform a 0-100 Technical SEO & AI Search (GEO) audit on any webpage",
        "operationId": "analyze_seo_api_v1_seo_audit_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeoAuditRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeoAuditResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SeoAuditRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "URL of the webpage to run a full Technical SEO & AI-Search (GEO) audit on.",
            "default": "https://example.com"
          }
        },
        "type": "object",
        "title": "SeoAuditRequest"
      },
      "SeoAuditResponse": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "overall_score": {
            "type": "integer",
            "title": "Overall Score"
          },
          "grade": {
            "type": "string",
            "title": "Grade"
          },
          "meta": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ],
              "nullable": true
            },
            "type": "object",
            "title": "Meta"
          },
          "headings_summary": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Headings Summary"
          },
          "images_audit": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Images Audit"
          },
          "links_audit": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Links Audit"
          },
          "structured_data_json_ld_count": {
            "type": "integer",
            "title": "Structured Data Json Ld Count"
          },
          "ai_geo_readiness": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Ai Geo Readiness"
          },
          "issues_and_recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues And Recommendations"
          }
        },
        "type": "object",
        "required": [
          "url",
          "overall_score",
          "grade",
          "meta",
          "headings_summary",
          "images_audit",
          "links_audit",
          "structured_data_json_ld_count",
          "ai_geo_readiness",
          "issues_and_recommendations"
        ],
        "title": "SeoAuditResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}