{
  "openapi": "3.0.3",
  "info": {
    "title": "LLM Output Repetition & Loop Deduplicator API",
    "description": "Detect and clean sentence and paragraph loops produced by generative models.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://rapidapi-10-in-1-suite.onrender.com",
      "description": "Production Render Cloud Server"
    }
  ],
  "paths": {
    "/api/v1/deduplicate-text/dedupe": {
      "post": {
        "tags": [
          "18. LLM Output Loop & Repetition Deduplicator"
        ],
        "summary": "Remove repetitive sentence and paragraph loops often generated by local or small LLMs",
        "operationId": "deduplicate_output_api_v1_deduplicate_text_dedupe_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DedupeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DedupeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DedupeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Repetitive or looping text generated by an LLM to clean up.",
            "default": "The API is ready. The API is ready. Please proceed with testing. Please proceed with testing. Thank you!"
          },
          "window_unit": {
            "type": "string",
            "title": "Window Unit",
            "description": "Deduplication granularity: 'sentence', 'line', or 'paragraph'.",
            "default": "sentence"
          }
        },
        "type": "object",
        "title": "DedupeRequest"
      },
      "DedupeResponse": {
        "properties": {
          "deduplicated_text": {
            "type": "string",
            "title": "Deduplicated Text"
          },
          "original_units_count": {
            "type": "integer",
            "title": "Original Units Count"
          },
          "cleaned_units_count": {
            "type": "integer",
            "title": "Cleaned Units Count"
          },
          "duplicates_removed": {
            "type": "integer",
            "title": "Duplicates Removed"
          }
        },
        "type": "object",
        "required": [
          "deduplicated_text",
          "original_units_count",
          "cleaned_units_count",
          "duplicates_removed"
        ],
        "title": "DedupeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}